{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pilot-rule.schema.json",
  "title": "Pilot Rule (LLM 출력)",
  "description": "LLM이 만드는 Rule 하나의 정적 스키마. 구조·타입·범위만 검사한다. 참조 해소(ID가 그래프에 있는가), 슬롯 종류, 인자 검사는 그래프가 필요하므로 검증기 코드가 한다(SPEC.md §9). target(대상 기기)과 args(동작 입력값)는 세 슬롯 모두에서 쓸 수 있다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "event",
    "action"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string"
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request-event"
      ],
      "properties": {
        "request-event": {
          "type": "array",
          "minItems": 1,
          "items": {
            "const": "user-request"
          }
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geographic-location": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "destination": {
              "$ref": "#/$defs/entityList"
            }
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "motion-action": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/motionAction"
          }
        },
        "perception-action": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/perceptionAction"
          }
        },
        "control-action": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/controlAction"
          }
        },
        "report-action": {
          "type": "array",
          "minItems": 1,
          "items": {
            "const": "report-result"
          }
        }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "description": "Identity 어휘의 id. 접두사 없이 쓴다(예: navigate-to)."
    },
    "entityName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "entityList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entityName"
      }
    },
    "step": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "motionAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "action-type"
      ],
      "properties": {
        "step": {
          "$ref": "#/$defs/step"
        },
        "action-type": {
          "$ref": "#/$defs/identity"
        },
        "destination": {
          "$ref": "#/$defs/entityList"
        },
        "target": {
          "$ref": "#/$defs/entityList"
        },
        "args": {
          "type": "object"
        }
      }
    },
    "perceptionAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "action-type"
      ],
      "properties": {
        "step": {
          "$ref": "#/$defs/step"
        },
        "action-type": {
          "$ref": "#/$defs/identity"
        },
        "object-class": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "target": {
          "$ref": "#/$defs/entityList"
        },
        "args": {
          "type": "object"
        }
      }
    },
    "controlAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "action-type"
      ],
      "properties": {
        "step": {
          "$ref": "#/$defs/step"
        },
        "action-type": {
          "$ref": "#/$defs/identity"
        },
        "target": {
          "$ref": "#/$defs/entityList"
        },
        "args": {
          "type": "object"
        }
      }
    }
  }
}
