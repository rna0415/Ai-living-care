[
  {
    "@context": [
      "https://www.w3.org/2022/wot/td/v1.1",
      { "id": "https://example.org/pilot-vocab#" }
    ],
    "title": "cobot-arm-1",
    "@type": "id:robot-arm",
    "description": "작업자와 안전 펜스 없이 같은 공간에서 부품 조립, 볼팅, 팔레타이징을 함께 수행할 수 있는 협동로봇입니다.",
    "aliases": ["코봇", "협동로봇", "조립 로봇"],
    "location": "assembly_line_A",
    "properties": {
      "location": {
        "@type": "id:current-location",
        "description": "협동로봇이 설치되어 있거나 작업 중인 공장 내 위치를 나타낸다.",
        "type": "string",
        "enum": [
          "assembly_line_A",
          "assembly_line_B",
          "cnc_machine_1",
          "press_machine_2",
          "inspection_desk",
          "packing_area"
        ],
        "readOnly": true
      },
      "current_task": {
        "@type": "id:running-state",
        "description": "로봇이 현재 수행 중인 작업의 이름이나 상태를 나타낸다.",
        "type": "string",
        "readOnly": true
      },
      "battery": {
        "@type": "id:battery-level",
        "description": "이동형 베이스가 있을 경우 배터리 잔량을 퍼센트로 나타낸다. 고정형인 경우 상시 100이다.",
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "unit": "%",
        "readOnly": true
      },
      "available_tools": {
        "@type": "id:equipment-state",
        "description": "현재 로봇에 장착 가능하거나 사용 가능한 엔드이펙터(툴)의 목록을 나타낸다.",
        "type": "array",
        "items": {
          "type": "string"
        },
        "readOnly": true
      }
    },
    "actions": {
      "pick_and_place": {
        "@type": "id:pick-and-place",
        "description": "진공패드, 전동그리퍼, 전자석 등을 사용해 부품을 집어서 지정된 위치로 이동시킨다.",
        "input": {
          "type": "object",
          "required": ["tool_type", "target_object"],
          "properties": {
            "tool_type": {
              "type": "string",
              "enum": ["vacuum_pad", "electric_gripper", "electromagnet"],
              "description": "부품을 집기 위해 사용할 툴 종류"
            },
            "target_object": {
              "type": "string",
              "description": "이동시킬 부품의 이름 또는 ID"
            }
          }
        }
      },
      "palletize": {
        "@type": "id:palletize",
        "description": "지그재그, 교차 적재 등의 패턴에 맞춰 파레트에 부품을 차곡차곡 쌓는다.",
        "input": {
          "type": "object",
          "required": ["pattern"],
          "properties": {
            "pattern": {
              "type": "string",
              "enum": ["zigzag", "cross", "straight"],
              "description": "파레트 적재 패턴"
            }
          }
        }
      },
      "depalletize": {
        "@type": "id:depalletize",
        "description": "파레트에 적재된 부품이나 박스를 걷어내어 컨베이어나 작업대로 옮긴다."
      },
      "bin_picking": {
        "@type": "id:bin-picking",
        "description": "3D 비전 센서를 사용하여 무작위로 쌓여 있는 부품의 자세를 인식한 뒤, 간섭 없이 정확히 집어낸다.",
        "input": {
          "type": "object",
          "required": ["target_part"],
          "properties": {
            "target_part": {
              "type": "string",
              "description": "빈(Bin) 안에서 찾아낼 부품의 이름"
            }
          }
        }
      },
      "machine_tending": {
        "@type": "id:machine-tending",
        "description": "CNC 선반, 사출성형기 등의 도어를 열고 가공할 소재를 투입한 뒤 완성품을 꺼낸다.",
        "input": {
          "type": "object",
          "required": ["machine_name"],
          "properties": {
            "machine_name": {
              "type": "string",
              "description": "텐딩 작업을 수행할 설비의 이름 (예: cnc_lathe_1)"
            }
          }
        }
      },
      "sort": {
        "@type": "id:sort-item",
        "description": "검사 결과에 따라 불량품을 별도의 트레이나 폐기함으로 분리한다."
      },
      "orient": {
        "@type": "id:orient-item",
        "description": "조립이나 가공이 가능하도록 부품의 각도와 방향을 회전시켜 정렬한다.",
        "input": {
          "type": "object",
          "required": ["angle_deg"],
          "properties": {
            "angle_deg": {
              "type": "number",
              "minimum": -360.0,
              "maximum": 360.0,
              "unit": "degree",
              "description": "부품을 회전시킬 각도(도)"
            }
          }
        }
      }
    },
    "events": {}
  },
  {
    "@context": [
      "https://www.w3.org/2022/wot/td/v1.1",
      { "id": "https://example.org/pilot-vocab#" }
    ],
    "title": "amr-fleet-1",
    "@type": "id:mobile-robot",
    "description": "라이다(LiDAR)와 카메라 센서로 맵을 그리고 스스로 장애물을 회피하며 자재를 이송하는 자율이동로봇입니다.",
    "aliases": ["이송 로봇", "자율이동로봇", "물류 로봇"],
    "location": "charging_dock_1",
    "properties": {
      "location": {
        "@type": "id:current-location",
        "description": "AMR의 현재 맵 상 위치를 나타낸다.",
        "type": "string",
        "enum": [
          "charging_dock_1",
          "warehouse_pallet_zone",
          "assembly_line_A",
          "elevator_hall_1f",
          "elevator_hall_2f",
          "cleanroom_entrance",
          "narrow_aisle_3"
        ],
        "readOnly": true
      },
      "current_task": {
        "@type": "id:running-state",
        "description": "AMR이 현재 수행 중인 이송 미션이나 상태를 나타낸다.",
        "type": "string",
        "readOnly": true
      },
      "battery": {
        "@type": "id:battery-level",
        "description": "로봇의 현재 배터리 잔량을 퍼센트로 나타낸다.",
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "unit": "%",
        "readOnly": true
      }
    },
    "actions": {
      "plan_and_navigate": {
        "@type": "id:navigate-to",
        "description": "목표 지점까지의 최적 경로를 계획하고 장애물을 회피하며 자율 주행한다.",
        "input": {
          "type": "object",
          "required": ["destination"],
          "properties": {
            "destination": {
              "type": "string",
              "description": "이동할 목적지의 장소 이름이나 좌표 식별자"
            }
          }
        }
      },
      "spot_turn": {
        "@type": "id:spot-turn",
        "description": "협소한 공장 통로, 교차로, 랙 사이에서 차체 중심을 기준으로 제자리에서 회전한다.",
        "input": {
          "type": "object",
          "required": ["angle_deg"],
          "properties": {
            "angle_deg": {
              "type": "number",
              "minimum": -360.0,
              "maximum": 360.0,
              "unit": "degree",
              "description": "제자리에서 회전할 각도(도)"
            }
          }
        }
      },
      "pick_and_place": {
        "@type": "id:pick-and-place",
        "description": "차체에 내장된 리프트 실린더를 상승시켜 파레트나 부품 대차를 들어올린 후 이동시키고 내려놓는다.",
        "input": {
          "type": "object",
          "required": ["target_object"],
          "properties": {
            "target_object": {
              "type": "string",
              "description": "들어올려 이동시킬 대상 파레트나 대차의 이름 또는 ID"
            }
          }
        }
      },
      "ride_elevator": {
        "@type": "id:ride-elevator",
        "description": "승강기 제어 시스템을 호출하여 문을 열고 탑승한 뒤, 지정한 목적 층으로 이동하여 하차한다.",
        "input": {
          "type": "object",
          "required": ["target_floor"],
          "properties": {
            "target_floor": {
              "type": "integer",
              "minimum": -5,
              "maximum": 100,
              "description": "이동할 목적 층의 숫자 (예: 지하 1층은 -1, 지상 2층은 2)"
            }
          }
        }
      },
      "request_auto_door_open": {
        "@type": "id:open-door",
        "description": "클린룸 에어샤워나 방화벽 자동문 접근 시 무선 신호를 보내 문을 개방시킨 후 통과한다.",
        "input": {
          "type": "object",
          "required": ["door_id"],
          "properties": {
            "door_id": {
              "type": "string",
              "description": "개방을 요청할 자동문의 식별 ID"
            }
          }
        }
      },
      "self_localization_recovery": {
        "@type": "id:recover-localization",
        "description": "주변 환경의 급격한 변화나 바퀴 슬립 등으로 위치 추정 신뢰도(Confidence)가 떨어졌을 때, 천장 랜드마크나 특정 벽면을 탐색해 현재 좌표를 재보정한다."
      }
    },
    "events": {}
  }
]
