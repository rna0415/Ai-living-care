{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    { "id": "https://example.org/pilot-vocab#" }
  ],
  "title": "cobot-arm-1",
  "@type": "id:robot-arm",
  "description": "작업자와 안전 펜스 없이 같은 공간에서 부품 조립, 볼팅, 팔레타이징을 함께 수행할 수 있는 협동로봇입니다.",
  "aliases": ["코봇", "협동로봇", "조립 로봇"],
  "location": "assembly_line_A",
  "properties": {
    "location": {
      "@type": "id:current-location",
      "description": "협동로봇이 설치되어 있거나 작업 중인 공장 내 위치를 나타낸다.",
      "type": "string",
      "enum": [
        "assembly_line_A",
        "assembly_line_B",
        "cnc_machine_1",
        "press_machine_2",
        "inspection_desk",
        "packing_area"
      ],
      "readOnly": true
    },
    "current_task": {
      "@type": "id:running-state",
      "description": "로봇이 현재 수행 중인 작업의 이름이나 상태를 나타낸다.",
      "type": "string",
      "readOnly": true
    },
    "battery": {
      "@type": "id:battery-level",
      "description": "이동형 베이스가 있을 경우 배터리 잔량을 퍼센트로 나타낸다. 고정형인 경우 상시 100이다.",
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "unit": "%",
      "readOnly": true
    },
    "available_tools": {
      "@type": "id:equipment-state",
      "description": "현재 로봇에 장착 가능하거나 사용 가능한 엔드이펙터(툴)의 목록을 나타낸다.",
      "type": "array",
      "items": { "type": "string" },
      "readOnly": true
    }
  },
  "actions": {
    "pick_and_place": {
      "@type": "id:pick-and-place",
      "description": "진공패드, 전동그리퍼, 전자석 등을 사용해 부품을 집어서 지정된 위치로 이동시킨다.",
      "input": {
        "type": "object",
        "required": ["tool_type", "target_object"],
        "properties": {
          "tool_type": {
            "type": "string",
            "enum": ["vacuum_pad", "electric_gripper", "electromagnet"]
          },
          "target_object": { "type": "string" }
        }
      }
    },
    "palletize": {
      "@type": "id:palletize",
      "description": "지그재그, 교차 적재 등의 패턴에 맞춰 파레트에 부품을 차곡차곡 쌓는다.",
      "input": {
        "type": "object",
        "required": ["pattern"],
        "properties": {
          "pattern": {
            "type": "string",
            "enum": ["zigzag", "cross", "straight"]
          }
        }
      }
    },
    "depalletize": {
      "@type": "id:depalletize",
      "description": "파레트에 적재된 부품이나 박스를 걷어내어 컨베이어나 작업대로 옮긴다."
    },
    "bin_picking": {
      "@type": "id:bin-picking",
      "description": "3D 비전 센서를 사용하여 무작위로 쌓여 있는 부품의 자세를 인식한 뒤, 간섭 없이 정확히 집어낸다.",
      "input": {
        "type": "object",
        "required": ["target_part"],
        "properties": {
          "target_part": { "type": "string" }
        }
      }
    },
    "machine_tending": {
      "@type": "id:machine-tending",
      "description": "CNC 선반, 사출성형기 등의 도어를 열고 가공할 소재를 투입한 뒤 완성품을 꺼낸다.",
      "input": {
        "type": "object",
        "required": ["machine_name"],
        "properties": {
          "machine_name": { "type": "string" }
        }
      }
    },
    "sort": {
      "@type": "id:sort-item",
      "description": "검사 결과에 따라 불량품을 별도의 트레이나 폐기함으로 분리한다."
    },
    "orient": {
      "@type": "id:orient-item",
      "description": "조립이나 가공이 가능하도록 부품의 각도와 방향을 회전시켜 정렬한다.",
      "input": {
        "type": "object",
        "required": ["angle_deg"],
        "properties": {
          "angle_deg": {
            "type": "number",
            "minimum": -360.0,
            "maximum": 360.0,
            "unit": "degree"
          }
        }
      }
    }
  },
  "events": {}
}
