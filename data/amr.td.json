{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    { "id": "https://example.org/pilot-vocab#" }
  ],
  "title": "amr-fleet-1",
  "@type": "id:mobile-robot",
  "description": "라이다(LiDAR)와 카메라 센서로 맵을 그리고 스스로 장애물을 회피하며 자재를 이송하는 자율이동로봇입니다.",
  "aliases": ["이송 로봇", "자율이동로봇", "물류 로봇"],
  "location": "charging_dock_1",
  "properties": {
    "location": {
      "@type": "id:current-location",
      "description": "AMR의 현재 맵 상 위치를 나타낸다.",
      "type": "string",
      "enum": [
        "charging_dock_1",
        "warehouse_pallet_zone",
        "assembly_line_A",
        "elevator_hall_1f",
        "elevator_hall_2f",
        "cleanroom_entrance",
        "narrow_aisle_3"
      ],
      "readOnly": true
    },
    "current_task": {
      "@type": "id:running-state",
      "description": "AMR이 현재 수행 중인 이송 미션이나 상태를 나타낸다.",
      "type": "string",
      "readOnly": true
    },
    "battery": {
      "@type": "id:battery-level",
      "description": "로봇의 현재 배터리 잔량을 퍼센트로 나타낸다.",
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "unit": "%",
      "readOnly": true
    }
  },
  "actions": {
    "plan_and_navigate": {
      "@type": "id:navigate-to",
      "description": "목표 지점까지의 최적 경로를 계획하고 장애물을 회피하며 자율 주행한다.",
      "input": {
        "type": "object",
        "required": ["destination"],
        "properties": {
          "destination": {
            "type": "string",
            "description": "이동할 목적지의 장소 이름이나 좌표 식별자"
          }
        }
      }
    },
    "spot_turn": {
      "@type": "id:spot-turn",
      "description": "협소한 공장 통로, 교차로, 랙 사이에서 차체 중심을 기준으로 제자리에서 회전한다.",
      "input": {
        "type": "object",
        "required": ["angle_deg"],
        "properties": {
          "angle_deg": {
            "type": "number",
            "minimum": -360.0,
            "maximum": 360.0,
            "unit": "degree",
            "description": "제자리에서 회전할 각도(도)"
          }
        }
      }
    },
    "pick_and_place": {
      "@type": "id:pick-and-place",
      "description": "차체에 내장된 리프트 실린더를 상승시켜 파레트나 부품 대차를 들어올린 후 이동시키고 내려놓는다.",
      "input": {
        "type": "object",
        "required": ["target_object"],
        "properties": {
          "target_object": {
            "type": "string",
            "description": "들어올려 이동시킬 대상 파레트나 대차의 이름 또는 ID"
          }
        }
      }
    },
    "ride_elevator": {
      "@type": "id:ride-elevator",
      "description": "승강기 제어 시스템을 호출하여 문을 열고 탑승한 뒤, 지정한 목적 층으로 이동하여 하차한다.",
      "input": {
        "type": "object",
        "required": ["target_floor"],
        "properties": {
          "target_floor": {
            "type": "integer",
            "minimum": -5,
            "maximum": 100,
            "description": "이동할 목적 층의 숫자 (예: 지하 1층은 -1, 지상 2층은 2)"
          }
        }
      }
    },
    "request_auto_door_open": {
      "@type": "id:open-door",
      "description": "클린룸 에어샤워나 방화벽 자동문 접근 시 무선 신호를 보내 문을 개방시킨 후 통과한다.",
      "input": {
        "type": "object",
        "required": ["door_id"],
        "properties": {
          "door_id": {
            "type": "string",
            "description": "개방을 요청할 자동문의 식별 ID"
          }
        }
      }
    },
    "self_localization_recovery": {
      "@type": "id:recover-localization",
      "description": "주변 환경의 급격한 변화나 바퀴 슬립 등으로 위치 추정 신뢰도(Confidence)가 떨어졌을 때, 천장 랜드마크나 특정 벽면을 탐색해 현재 좌표를 재보정한다."
    }
  },
  "events": {}
}
